{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A container for a set of AI instructions.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Project name" },
        "ownerId": { "type": "string", "description": "UID of the project owner" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "InstructionSet": {
      "title": "Instruction Set",
      "description": "The actual content of the instructions.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "llmsTxt": { "type": "string" },
        "llmsFullTxt": { "type": "string" },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "changeSummary": { "type": "string" }
      },
      "required": ["projectId", "systemInstruction", "version", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Root project documents"
    },
    "/projects/{projectId}/versions/{versionId}": {
      "schema": "InstructionSet",
      "description": "Historical versions of instructions for a project"
    }
  }
}
